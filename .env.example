# Local configuration. Copy to .env (git-ignored) and fill in:
#
#   cp .env.example .env
#
# bin/ scripts load .env automatically. For terraform/aws/kubectl in your own
# shell, load it first:
#
#   set -a; . ./.env; set +a
#
# Keep comments on their own lines; the file is read as shell.

# --- AWS credentials (optional) ----------------------------------------------
# Named profile from ~/.aws/config. Leave unset to use the default credential
# chain (environment variables, SSO session, instance role, ...).
# AWS_PROFILE=my-profile
AWS_REGION=eu-west-1

# --- Terraform inputs (aws/envs/eu-dev) -----------------------------------
# Short deployment tag used as <tag>-<resource>, for example eu-dev-eks and
# eu-dev-sample-app. Change it to values such as eu-prd, us-dev or us-stg for
# another lifecycle or geography. The physical AWS region stays separate.
TF_VAR_environment=eu-dev
# Existing VPC to deploy into. It needs, in at least two Availability Zones:
#   - private subnets with outbound internet access through a NAT gateway. VPC
#     endpoints alone are not enough: images also come from ghcr.io, quay.io
#     and public.ecr.aws, and Flux pulls this repository from GitHub.
#   - public subnets (route to an internet gateway) for the internet-facing ALB.
TF_VAR_vpc_id=vpc-0123456789abcdef0
# Optional: the private subnets for the control plane, nodes, Fargate and EFS.
# Unset, Terraform uses every subnet in the VPC with auto-assign public IP off,
# which also catches database or other isolated subnets. Set it if the VPC has
# any. HCL list syntax, single-quoted for the shell:
# TF_VAR_private_subnet_ids='["subnet-0123456789abcdef0","subnet-0fedcba9876543210"]'

# --- Custom domain (opt-in) --------------------------------------------------
# Leave these unset to serve the sample app over HTTP on the ALB's DNS name.
# Set TF_VAR_route53_zone_id to reuse a hosted zone that is already delegated
# for the domain; otherwise Terraform creates a new zone. After the ALB exists,
# Terraform creates an alias record for <app_subdomain>.<domain_name>. Also
# enable the custom-domain component in
# flux/envs/eu-dev/kgateway/kustomization.yaml
# for the HTTPS listener. The ACM certificate must already exist in the region
# and cover the app hostname.
# TF_VAR_domain_name=example.com
# TF_VAR_app_subdomain=books
# TF_VAR_route53_zone_id=Z1234567890ABC
# TF_VAR_acm_certificate_arn=arn:aws:acm:eu-west-1:111122223333:certificate/00000000-0000-0000-0000-000000000000
