# Example values for the variables Flux substitutes into the manifests
# (${VAR} placeholders). They are placeholders, not a real account.
#
# The real values are Terraform outputs (`terraform output flux_vars`), turned
# into the flux-system/cluster-vars ConfigMap by `bin/cluster-config.sh
# apply-flux`. bin/validate.sh renders with this file so the local gate needs
# no AWS account. Keep the keys in sync with the flux_vars output in
# aws/envs/eu-west-1/outputs.tf.
ECR_REGISTRY=111122223333.dkr.ecr.eu-west-1.amazonaws.com
ENV_PREFIX=demo-eu-west-1
CLUSTER_NAME=demo-eu-west-1-eks
KARPENTER_NODE_ROLE=demo-eu-west-1-karpenter-node
APP_HOSTNAME=app.example.com
ACM_CERTIFICATE_ARN=arn:aws:acm:eu-west-1:111122223333:certificate/00000000-0000-0000-0000-000000000000
